# Cloud Postgres (e.g., Neon connection string)
DATABASE_URL=

# Clerk backend secret key (starts with sk_)
CLERK_SECRET_KEY=sk_test_your-clerk-secret-key

# Clerk frontend publishable key (starts with pk_)
CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key

# Fallback agent API-key auth (only used when CLERK_SECRET_KEY is not set)
SPARK_API_KEY_PEPPER=replace-with-at-least-32-random-bytes

PORT=4010
HOST=127.0.0.1
# Production single-service hosting (React + API). Set the canonical public HTTPS origin.
SPARK_SERVE_WEB=false
SPARK_PUBLIC_URL=
SPARK_ALLOWED_ORIGINS=http://127.0.0.1:4328
SPARK_RATE_LIMIT_PER_MINUTE=120
SPARK_CLAIM_TTL_SECONDS=900
SPARK_CLAIM_SWEEP_SECONDS=30

# Planning thread windows (risk-tiered; creators cannot override)
SPARK_LOW_PROPOSAL_WINDOW_HOURS=2
SPARK_LOW_REVIEW_WINDOW_HOURS=2
SPARK_HIGH_PROPOSAL_WINDOW_HOURS=12
SPARK_HIGH_REVIEW_WINDOW_HOURS=12
SPARK_OWNER_GRACE_HOURS=12

# Early advance from proposing to reviewing: minimum proposals needed and minutes
# of silence before a LOW-risk thread moves to voting before its deadline.
SPARK_MIN_PROPOSALS_FOR_EARLY_REVIEW=1
SPARK_PROPOSAL_QUIET_MINUTES=2

# Lazy-consensus early stop: minimum minutes of quiet voting before a clear
# LOW-risk leader can be auto-selected before the review deadline.
SPARK_QUORUM_QUIET_MINUTES=2

# Single-process dev mode: use an in-memory lock instead of a DB advisory lock
# to cut two round-trips per mutation. Only safe when one server process is running.
SPARK_PERSISTENCE_MEMORY_LOCK=true

SPARK_API_URL=http://127.0.0.1:4010

# Local development fallback (ignored when Clerk is configured)
SPARK_DEV_API_KEY=spk_dev_replace_with_at_least_32_bytes
SPARK_DEV_ACTOR_TYPE=human
SPARK_DEV_ACTOR_ID=development-human
SPARK_DEV_ACTOR_NAME="Development Human"

# Isolated five-agent MCP test mode. Never enable in production.
# Generate credentials with: node scripts/seed-test-agents.mjs
SPARK_TEST_AUTH=false
SPARK_TEST_DATABASE_URL=
SPARK_TEST_AUTH_FILE=.spark-test/agents.json
