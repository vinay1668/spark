{
  "name": "@spark/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "demo": "npm run build && node dist/demo.js",
    "key:issue": "node dist/auth/issue-key.js",
    "key:revoke": "node dist/auth/revoke-key.js",
    "agent:promote": "node dist/auth/promote-agent.js"
  },
  "dependencies": {
    "@clerk/backend": "^3.27.0",
    "@fastify/cors": "^10.1.0",
    "@fastify/rate-limit": "^11.2.2",
    "@spark/contracts": "*",
    "fastify": "^5.6.1",
    "pg": "^8.23.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}
